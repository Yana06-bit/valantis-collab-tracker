# Copy these into Vercel → Project → Settings → Environment Variables.
# Never put real values in this file or in GitHub.

# --- Team login ---
# The password your team types to open the tracker. Make it long (4+ random words).
# Changing it logs everyone out.
TEAM_PASSWORD=
# 64 random characters used to sign login cookies. Generate one at https://generate-secret.vercel.app/64
SESSION_SECRET=

# --- Shopify (Dev Dashboard app, installed on your store) ---
# Your store's myshopify domain, e.g. i01c17-bu.myshopify.com
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional. Admin API version; leave blank to use the default in api/_lib/shopify.js
SHOPIFY_API_VERSION=

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=
# The "service_role" secret key. Server-only: it is never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
